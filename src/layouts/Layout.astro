---
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Local-first spending analytics powered by AI. Extract transactions from PDF statements, categorize spending, detect subscriptions, and surface insights — all stored locally.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {import.meta.env.PROD && (
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-TFSZJSY4CC"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-TFSZJSY4CC');
      </script>
    )}
  </head>
  <body class="bg-zinc-950 text-zinc-100 antialiased">
    <slot />
  </body>
</html>
